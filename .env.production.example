# Production environment TEMPLATE for docker-compose.prod.yml. Placeholders only.
# Copy to .env.production on the server (it is git-ignored), fill in real values, never commit it.
# Keep POSTGRES_PASSWORD URL-safe (letters, digits, - and _ only): it is embedded in DATABASE_URL.

# Release identity: use the commit SHA of the approved, CI-green commit. Never "latest".
RELEASE_TAG=<commit-sha>

POSTGRES_DB=vedzmani
POSTGRES_USER=vedzmani
POSTGRES_PASSWORD=<generate-a-long-random-url-safe-value>

# At least 50 random characters. prod.py refuses to boot with a placeholder or a key shorter than 32.
DJANGO_SECRET_KEY=<generate-a-long-random-value>

# Domain. localhost is NOT listed: the container health check sends PRIMARY_HOST as its Host header.
PRIMARY_HOST=vedzmani.ir
# "backend" is required: the Next.js server calls the API at http://backend:8000 (API_INTERNAL_URL), so Django sees
# Host "backend:8000". Without it every server-rendered catalog request fails with HTTP 400 (verified on the VPS).
# Public requests cannot use that Host: Nginx answers 421 for any Host that is not a configured server name.
DJANGO_ALLOWED_HOSTS=vedzmani.ir,www.vedzmani.ir,backend
CSRF_TRUSTED_ORIGINS=https://vedzmani.ir,https://www.vedzmani.ir
# Same-origin topology: only needed if a browser origin other than the site itself calls the API.
CORS_ALLOWED_ORIGINS=https://vedzmani.ir,https://www.vedzmani.ir

# Baked into the frontend image at build time (changing it requires a rebuild).
NEXT_PUBLIC_API_URL=https://vedzmani.ir

# Host directory that contains origin.pem and origin.key (see docs/PRODUCTION_INFRASTRUCTURE.md). Outside the repo.
ORIGIN_CERT_DIR=/etc/vedzmani/certs

# Keep 0 until HTTPS is verified end to end, then raise in steps (e.g. 300, then 86400, then 31536000).
DJANGO_HSTS_SECONDS=0
