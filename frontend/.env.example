# Browser-visible values only (NEXT_PUBLIC_*). Never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only: how the Next.js server reaches Django.
# Local dev: http://localhost:8000   Docker Compose: http://backend:8000
API_INTERNAL_URL=http://localhost:8000
# Indexing is OFF by default (staging protection). Set true at build time for production.
SITE_ALLOW_INDEXING=false
# Public site origin (enables canonical/alternate language URLs), e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
