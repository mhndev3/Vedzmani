# Backend environment (local, outside Docker). Copy to .env - never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vedzmani:vedzmani@localhost:5432/vedzmani
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Auth / OTP (all optional; defaults shown)
# OTP_DELIVERY_BACKEND=apps.accounts.delivery.UnconfiguredDelivery  # dev settings default to ConsoleDelivery
# AUTH_TRUSTED_PROXY_COUNT=0   # set to 1 behind Nginx so per-IP rate limits see the real client
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# Melipayamak shared-service API (server-side secret URL; never expose to the browser or commit it).
# OTP_DELIVERY_BACKEND=apps.accounts.delivery.MelipayamakDelivery
# MELIPAYAMAK_SHARED_API_URL=https://console.melipayamak.com/api/send/shared/your-private-token
# MELIPAYAMAK_BODY_ID=591009
# MELIPAYAMAK_TIMEOUT_SECONDS=10
# AUTH_REMEMBER_ME_SECONDS=2592000

# SEP OnlinePG: real payments remain disabled until terminal and shipping policy are configured
SEP_PAYMENT_ENABLED=false
# SEP_TERMINAL_ID=provided-by-SEP
# SEP_SHIPPING_AMOUNT_TOMAN=...  # required before payment can be initiated; fixed shipping fee only
# SEP_TIMEOUT_SECONDS=15

# TorobPay CPG: leave disabled until credentials, shipping tariff and payment flow are verified.
TOROBPAY_ENABLED=false
# TOROBPAY_CLIENT_ID=provided-by-TorobPay
# TOROBPAY_CLIENT_SECRET=provided-by-TorobPay
# TOROBPAY_USERNAME=provided-by-TorobPay
# TOROBPAY_PASSWORD=provided-by-TorobPay
# TOROBPAY_BASE_URL=https://cpg.torobpay.com
# TOROBPAY_TIMEOUT_SECONDS=15
