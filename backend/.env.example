# Backend environment (local, outside Docker). Copy to .env - never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vedzmani:vedzmani@localhost:5432/vedzmani
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Auth / OTP (all optional; defaults shown)
# OTP_DELIVERY_BACKEND=apps.accounts.delivery.UnconfiguredDelivery  # dev settings default to ConsoleDelivery
# AUTH_TRUSTED_PROXY_COUNT=0   # set to 1 behind Nginx so per-IP rate limits see the real client
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# AUTH_REMEMBER_ME_SECONDS=2592000
